    {"id":"B47","title":"Duplicate side effect","suites":["H"],"example":"retry repeats write/post/upload","detector":"idempotency guard","layer":"runtime","first_release":false},
    {"id":"B48","title":"Stale checkpoint resume","suites":["H"],"example":"wrong execution state restored","detector":"state validator","layer":"runtime","first_release":false},
    {"id":"B49","title":"Provider fallback corrupts tool history","suites":["H"],"example":"tool call/result mismatch","detector":"message validator","layer":"runtime","first_release":false},
    {"id":"B50","title":"Success with pathological cost","suites":["F","G"],"example":"task passes after huge tokens/retries","detector":"efficiency benchmark","layer":"runtime","first_release":true}
  ],
  "negative_controls": [
    {"id":"N01","title":"Standard library import","expected":"no CodeCortex lookup","first_release":true},
    {"id":"N02","title":"New local variable rename","expected":"no blast-radius scan","first_release":true},
    {"id":"N03","title":"Markdown edit","expected":"no AST analysis","first_release":true},
    {"id":"N04","title":"Runtime API/network failure","expected":"graph does not pretend to solve it","first_release":true},
    {"id":"N05","title":"Binary-file parsing failure","expected":"graph defers to runtime/file tooling","first_release":true}
  ]
}
