    {"id":"B35","title":"Huge tool output","suites":["E","G"],"example":"100KB grep/archive output","detector":"output governor","layer":"runtime","first_release":true},
    {"id":"B36","title":"Context amplification","suites":["G"],"example":"same large history resent repeatedly","detector":"execution intelligence","layer":"runtime","first_release":true},
    {"id":"B37","title":"Late summarization","suites":["G"],"example":"compaction waits until 850k","detector":"token policy","layer":"runtime","first_release":false},
    {"id":"B38","title":"Retry storm","suites":["F"],"example":"same error repeated dozens of times","detector":"loop breaker","layer":"runtime","first_release":true},
    {"id":"B39","title":"Same tool + same args repeated","suites":["F"],"example":"no state change between calls","detector":"stagnation detector","layer":"runtime","first_release":true},
    {"id":"B40","title":"Same file repeatedly reread","suites":["F","G"],"example":"context waste without progress","detector":"execution intelligence","layer":"runtime","first_release":false},
    {"id":"B41","title":"Same test rerun without code change","suites":["F"],"example":"test loop","detector":"execution intelligence","layer":"runtime","first_release":false},
    {"id":"B42","title":"No-progress loop","suites":["F"],"example":"calls increase, state unchanged","detector":"execution intelligence","layer":"runtime","first_release":true},
    {"id":"B43","title":"Tool output truncated incorrectly","suites":["E"],"example":"important evidence lost","detector":"output continuation protocol","layer":"runtime","first_release":false},
    {"id":"B44","title":"Cancellation ignored","suites":["H"],"example":"process keeps running after cancel","detector":"runtime control","layer":"runtime","first_release":false},
