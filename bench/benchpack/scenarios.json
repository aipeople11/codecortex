{
  "version": 1,
  "status": "proposed: scenarios are defined, none implemented or run yet",
  "source_note": "Failure examples come from the team's historical agent-log analysis (91 sessions with hard errors across 327 logs; file/path errors the largest category). Counts not re-verified in this repository.",
  "metrics": ["correctness", "prevention", "efficiency", "recovery", "evidence_quality"],
  "efficiency_measures": ["total_input_tokens", "peak_context_per_call", "model_calls", "tool_calls", "duplicate_calls", "context_growth", "time_to_useful_progress", "first_correct_action_step"],
  "suites": {
    "A": "Repository intelligence",
    "B": "Filesystem and path intelligence",
    "C": "Tool and environment readiness",
    "D": "Data and format safety",
    "E": "Search and command efficiency",
    "F": "Execution loop intelligence",
    "G": "Context and token efficiency",
    "H": "Runtime and protocol reliability"
  },
  "scenarios": [
    {"id":"B01","title":"Hallucinated internal symbol","suites":["A"],"example":"create_serializer does not exist","detector":"CodeCortex graph","layer":"static","first_release":true},
    {"id":"B02","title":"Hallucinated module export","suites":["A"],"example":"_load_skills, get_model_policy","detector":"CodeCortex graph","layer":"static","first_release":true},
    {"id":"B03","title":"Wrong function arity","suites":["A"],"example":"build_resolved_run_config() given 1 arg","detector":"CodeCortex signature check","layer":"static","first_release":true},
    {"id":"B04","title":"Wrong keyword argument","suites":["A"],"example":"JSONLSaver(dir_path=...)","detector":"CodeCortex signature check","layer":"static","first_release":true},
    {"id":"B05","title":"Missing class method","suites":["A"],"example":"CapabilityRegistry.list_all","detector":"CodeCortex graph","layer":"static","first_release":false},
    {"id":"B06","title":"Stale API assumption","suites":["A"],"example":"ModelPolicy.evaluate missing","detector":"CodeCortex graph","layer":"static","first_release":false},
    {"id":"B07","title":"Ambiguous duplicate symbol","suites":["A"],"example":"same class/function in multiple historical files","detector":"CodeCortex graph","layer":"static","first_release":true},
    {"id":"B08","title":"Caller contract break","suites":["A"],"example":"edit changes signature but callers remain old","detector":"edit_check / impact","layer":"static","first_release":true},
    {"id":"B09","title":"Duplicate implementation","suites":["A"],"example":"agent creates helper already present","detector":"clone / exemplar search","layer":"static","first_release":true},
    {"id":"B10","title":"Wrong implementation exemplar","suites":["A"],"example":"agent invents new route/middleware style","detector":"exemplar retrieval","layer":"static","first_release":false},
    {"id":"B11","title":"Wrong affected-test selection","suites":["A"],"example":"changed symbol has dependent tests agent misses","detector":"graph + test mapping","layer":"static","first_release":true},
    {"id":"B12","title":"Wrong file/version modified","suites":["A"],"example":"active source vs backup/legacy copy","detector":"graph + git state","layer":"static","first_release":false},
    {"id":"B13","title":"Virtual vs host path confusion","suites":["B"],"example":"/skills works in virtual FS, fails in Python subprocess","detector":"runtime guard","layer":"runtime","first_release":true},
    {"id":"B14","title":"Relative/absolute path error","suites":["B"],"example":"tmp/... vs /tmp/...","detector":"runtime/path guard","layer":"runtime","first_release":false},
    {"id":"B15","title":"Hallucinated directory","suites":["B"],"example":"/memory/telemetry/ instead of actual log dir","detector":"discovery guard","layer":"runtime","first_release":true},
    {"id":"B16","title":"Blind path retry loop","suites":["B"],"example":"repeatedly probing missing .env paths","detector":"loop detector","layer":"runtime","first_release":true},
    {"id":"B17","title":"Missing executable","suites":["C"],"example":"pytest: command not found","detector":"environment preflight","layer":"runtime","first_release":true},
    {"id":"B18","title":"Wrong interpreter/venv","suites":["C"],"example":"global Python instead of project venv","detector":"environment preflight","layer":"runtime","first_release":false},
    {"id":"B19","title":"Non-Git workspace assumption","suites":["B","C"],"example":"git status in scratch folder","detector":"prerequisite check","layer":"runtime","first_release":false},
    {"id":"B20","title":"Unbounded grep","suites":["E"],"example":"grep / or /.","detector":"scope guard","layer":"runtime","first_release":true},
